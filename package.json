{
  "name": "autosocial",
  "version": "1.0.0",
  "description": "Automated PC hardware news → Turkish tweets pipeline",
  "main": "dist/main.js",
  "scripts": {
    "dev": "chcp 65001 >NUL && tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc",
    "build:client": "pnpm --filter client build",
    "build:all": "pnpm run build:client && tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test:fetch": "tsx scripts/test-fetch.ts",
    "test:ai": "tsx scripts/test-ai.ts",
    "test:tweet": "tsx scripts/test-tweet.ts",
    "test:image": "tsx scripts/test-image.ts",
    "test:digest": "tsx scripts/test-digest.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "axios": "^1.7.9",
    "bullmq": "^5.34.2",
    "cheerio": "^1.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "express": "^5.2.1",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "rss-parser": "^3.13.0",
    "sharp": "^0.33.5",
    "telegraf": "^4.16.3",
    "twitter-api-v2": "^1.18.2",
    "youtube-dl-exec": "^3.1.13",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
