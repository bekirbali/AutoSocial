# Uygulama
NODE_ENV=development
LOG_LEVEL=debug
APP_MODE=hybrid

# Veritabanı (Docker Compose ile local)
DATABASE_URL=postgresql://autosocial:autosocial_dev@localhost:5432/autosocial
REDIS_URL=redis://localhost:6379

# X (Twitter) API
X_CONSUMER_KEY=
X_CONSUMER_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Gemini AI
GEMINI_API_KEY=

# Telegram Bot (Faz 3'te aktif edilecek)
TELEGRAM_HTTP_API=
TELEGRAM_CHAT_ID=

# Sistem Ayarları
MAX_TWEETS_PER_DAY=15
MIN_TWEETS_PER_DAY=8
MIN_SCORE_THRESHOLD=70
FETCH_INTERVAL_MINUTES=15
ANALYTICS_FETCH_INTERVAL_HOURS=6

# Tweet dili
TWEET_LANG=tr
